# PostgreSQL connection string (replace USER and PASSWORD with your local credentials)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/personal_hub"

# Auth (Better Auth)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET="replace-with-generated-secret"
# Public app URL. Required in production, leave unset locally
# (so signing in from another device on your LAN keeps working)
# BETTER_AUTH_URL="https://your-app.example.com"
